# Pinned toolchain. Bumping a value needs the maintainer's go, then `tools/setup.sh --lock`.
# Debian 13 cross binutils (2.44, assembles -march=r5900 with the MMI and COP2 opcodes), used only when the system has none.
BINUTILS_DEB=pool/main/b/binutils-mipsen/binutils-mipsel-linux-gnu_2.44-3cross1+nmu1+b1_amd64.deb
# objdiff (Apache-2.0): function-level diff and progress reports.
OBJDIFF_TAG=v3.8.3
# wibo (MIT): runs the Win32 command-line compiler mwccps2.exe on Linux.
WIBO_TAG=1.2.0
# Source tools, pinned by commit: m2c (GPL-3.0, decompiler), decomp-permuter (MIT), asm-differ (Unlicense).
M2C_REV=c632946b8cfbe8fce442b522dba92dfa72f1f317
PERMUTER_REV=860b6d95b5350c2677c89b0c195c7bf3bb6bad0b
ASM_DIFFER_REV=0dd09af8f8008f1f880327cf0aca3b26d2562ea2
# Metrowerks CodeWarrior for PS2 (mwccps2.exe, commercial): decomp.me's compiler kits
# (github.com/decompme/compilers, release "compilers"), fetched for local use only, never tracked.
# All four write "MW MIPS C Compiler (2.4.1.01)" in .comment, so the comment does not pick one;
# 3.0.1 is the default of the Makefile (MWCC_VER), the others are kept for the phase 1 comparison.
MWCC_KITS="mwcps2-3.0-011126 mwcps2-3.0.1-020123 mwcps2-3.0.3-020716 mwcps2-2.4-001213"
