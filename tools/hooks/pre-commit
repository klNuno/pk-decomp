#!/usr/bin/env bash
# Refuses game data, oversized files, protected-file edits and inline asm.
# Wire once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
fail=0

# Game file types, wherever they sit (the .gitignore can be bypassed with git add -f).
data_re='\.(bin|iso|img|chd|cue|mdf|mds|ecm|elf|irx|icn|pss|lvl|ptr|tbf|sta|inf|txc|hst|scr|vag|vb|ps2|psu|max|mcd|sav|png|jpe?g|wav|ogg)$|(^|/)(SL[EU]S|SCES)_[0-9]{3}\.[0-9]{2}$|(^|/)SYSTEM\.CNF$'
while IFS= read -r -d '' f; do
  case "$f" in
    disks/README.md) ;;
    disks/*|extract/*|asm/*|assets/*|build/*|expected/*|captures/*|linker/*|work/*|tools/dl/*|tools/bin/*|tools/binutils/*|tools/mwcc/*|tools/src/*)
      echo "game data or toolchain staged: $f"; fail=1 ;;
  esac
  # Small PNG screenshots for the findings in docs/discoveries.md are the one allowed image type.
  if printf '%s' "$f" | grep -qE '^docs/img/game/[A-Za-z0-9_-]+\.png$'; then
    if [ "$(git cat-file -s ":$f" 2>/dev/null || echo 0)" -gt 204800 ]; then echo "screenshot over 200 KB: $f"; fail=1; fi
  elif printf '%s' "$f" | grep -qiE "$data_re"; then echo "game file type staged: $f"; fail=1; fi
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt 1048576 ]; then echo "file over 1 MB staged: $f"; fail=1; fi
  # An ELF or IRX under any name: the four magic bytes 7f 45 4c 46.
  if [ "$(git cat-file blob ":$f" 2>/dev/null | head -c 4 | od -An -tx1 | tr -d ' \n')" = 7f454c46 ]; then
    echo "ELF file staged: $f"; fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Target hashes, toolchain, build flags and these hooks change only on the maintainer's go (then PK_PROTECTED_OK=1).
protected='^(config/.*\.sha1|tools/versions\.env|tools/toolchain\.sha256|tools/requirements\.lock|Makefile|tools/hooks/.*)$'
if [ "${PK_PROTECTED_OK:-0}" != 1 ] && git rev-parse -q --verify HEAD >/dev/null; then
  if git diff --cached --name-only | grep -qE "$protected"; then
    echo "protected file changed: needs the maintainer's go, then commit with PK_PROTECTED_OK=1"; fail=1
  fi
fi

# C and C++ sources: no inline asm, no forced registers, except the INCLUDE_ASM header.
if git diff --cached -U0 -- '*.c' '*.cpp' '*.h' '*.hpp' ':!include/include_asm.h' | grep -E '^\+' \
  | grep -qE '(__asm__|\basm)[[:space:]]*(volatile[[:space:]]*)?[({]|register[^;]*\basm\b'; then
  echo "inline asm or forced register in staged C/C++"; fail=1
fi

exit $fail
